    <string name="upgrade_screen_owned_sub_renewing_body">您的訂閱為作用中且會自動續訂。</string>
    <string name="upgrade_screen_owned_sub_not_renewing_body">您的訂閱為作用中，但已設定不自動續訂。Pro 會持續到目前期間結束為止。</string>
    <string name="upgrade_screen_owned_both_renewing_warning">您擁有一次性購買，但訂閱仍在續訂。請在 Google Play 中取消以避免重複付費。</string>
    <string name="upgrade_screen_manage_subscription_action">管理訂閱</string>

    <string name="upgrade_screen_switch_locked_note">請先透過「管理訂閱」取消續訂，否則您會被收取兩筆費用。</string>
    <string name="upgrade_screen_switch_purchase_note">您的訂閱不會續訂——您現在可以安全購買一次性購買。</string>

    <string name="upgrade_screen_sub_still_renewing_title">訂閱仍在作用中</string>
    <string name="upgrade_screen_sub_still_renewing_message">您的訂閱仍設定為續訂。請先在 Google Play 中取消續訂，以免被收取兩筆費用，然後購買一次性購買。</string>
    <string name="upgrade_screen_purchase_check_failed_title">無法驗證</string>
    <string name="upgrade_screen_purchase_check_failed_message">Butler 無法與 Google Play 確認您的購買狀態，因此購買已停止以避免重複扣款。請稍後重試。</string>

    <string name="upgrade_screen_pending_card_title">付款待處理</string>
    <string name="upgrade_screen_pending_card_body">Google Play 仍在處理您的付款。付款完成後 Pro 會自動解鎖。某些付款方式可能需要一段時間。您無需執行其他任何操作。</string>
    <string name="upgrade_screen_pending_dialog_message">Google Play 發現一筆待處理付款的購買，正在處理中。付款完成後 Pro 會自動解鎖。</string>

    <string name="upgrade_screen_grace_title">確認您的購買</string>
    <string name="upgrade_screen_grace_body_short">Google Play 正在片刻之間確認您的 Pro 狀態。您仍有完整存取權。</string>
    <string name="upgrade_screen_grace_body">Google Play 仍未重新確認您的 Pro 狀態。您目前仍有存取權。如果看起來不對，請嘗試復原您的購買。</string>

    <string name="upgrades_gplay_already_owned_error_title">已購買？</string>
    <string name="upgrades_gplay_already_owned_error_description">Google Play 報告您已擁有此升級，但無法自動復原。請確保您使用原購買時所用的 Google 帳戶登入，然後嘗試「復原購買」。</string>
    <string name="upgrades_gplay_unavailable_error_title">Google Play 無法使用</string>
    <string name="upgrades_gplay_unavailable_error_description">Butler 無法連線至 Google Play。Google Play 已安裝且為最新版本嗎？您的 Google 帳戶已登入嗎？請嘗試清除 Google Play 應用程式的快取並重新啟動您的裝置。</string>
    <!-- Toast shown when the "Google Play" button of an error dialog can't open Google Play's app info, e.g. Google Play is missing or blocked on this device. "Google Play" is a brand name, keep it untranslated. -->
    <string name="upgrades_gplay_not_installed_message">無法開啟 Google Play。它可能在此裝置上遺失、已停用或受限。</string>
    <string name="upgrades_gplay_billing_error_label">Google Play 問題</string>
    <string name="upgrades_gplay_billing_error_description">與 Google Play 通訊時發生錯誤。請稍後重試或重新啟動您的裝置。\n\n詳細資訊：%s</string>
    <string name="upgrades_gplay_internal_error_title">Google Play 錯誤</string>
    <string name="upgrades_gplay_internal_error_description">Google Play 遇到內部錯誤。請嘗試下列操作：\n\n• 重新啟動您的裝置\n• 清除 Google Play Store 快取\n• 稍後重試</string>
    <string name="upgrades_gplay_network_error_title">連線錯誤</string>
    <string name="upgrades_gplay_network_error_description">Butler 無法連線至 Google Play。請檢查您的網際網路連線並重試。</string>
    <string name="upgrades_gplay_offer_unavailable_title">優惠無法使用</string>
    <string name="upgrades_gplay_offer_unavailable_description">Google Play 目前未為您的帳戶提供此升級選項。請稍後重試或查看 Google Play Store。</string>
    <string name="upgrades_no_purchases_found_check_account">未找到購買。您是否使用正確的帳戶？</string>

