    <string name="upgrade_screen_subscription_offer_body">开始时有免费的 14 天试用，然后每年计费一次。随时可以取消。</string>
    <string name="upgrade_screen_subscription_offer_body_no_trial">每年计费一次。随时可以取消。</string>
