    <string name="upgrade_screen_manage_subscription_action">管理订阅</string>

    <string name="upgrade_screen_switch_locked_note">首先通过"管理订阅"取消续费，否则您会同时被扣费。</string>
    <string name="upgrade_screen_switch_purchase_note">您的订阅将不再续费——您现在可以安全地购买一次性购买。</string>

    <string name="upgrade_screen_sub_still_renewing_title">订阅仍然有效</string>
    <string name="upgrade_screen_sub_still_renewing_message">您的订阅仍然设置为续费。首先在 Google Play 中取消续费，以便您不会同时被扣费，然后购买一次性购买。</string>
    <string name="upgrade_screen_purchase_check_failed_title">无法验证</string>
    <string name="upgrade_screen_purchase_check_failed_message">Butler 无法与 Google Play 确认您的购买状态，所以购买被停止以避免您被重复扣费。请稍后重试。</string>

    <string name="upgrade_screen_pending_card_title">待处理付款</string>
    <string name="upgrade_screen_pending_card_body">Google Play 仍在处理您的付款。付款处理后，Pro 将自动解锁。某些付款方式可能需要一段时间。您无需做任何其他操作。</string>
    <string name="upgrade_screen_pending_dialog_message">Google Play 发现了一笔待处理付款的购买，仍在处理中。付款处理后，Pro 将自动解锁。</string>

    <string name="upgrade_screen_grace_title">确认您的购买</string>
    <string name="upgrade_screen_grace_body_short">Google Play 正在花时间确认您的 Pro 状态。您仍然拥有完全访问权限。</string>
    <string name="upgrade_screen_grace_body">Google Play 仍未重新确认您的 Pro 状态。您现在仍有访问权限。如果这看起来不对，请尝试恢复购买。</string>

    <string name="upgrades_gplay_already_owned_error_title">已购买？</string>
    <string name="upgrades_gplay_already_owned_error_description">Google Play 报告您已拥有此升级，但它无法自动恢复。请确保您登录的 Google 账户与原始购买使用的账户相同，然后尝试"恢复购买"。</string>
    <string name="upgrades_gplay_unavailable_error_title">Google Play 不可用</string>
    <string name="upgrades_gplay_unavailable_error_description">Butler 无法连接到 Google Play。Google Play 已安装且是最新版本吗？您的 Google 账户已登录吗？尝试清除 Google Play 应用缓存并重启设备。</string>
