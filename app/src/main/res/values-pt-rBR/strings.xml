    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">Comece com uma aba</string>
    <string name="tour_first_tab_body">O Butler funciona em abas, como um navegador: cada uma é uma ferramenta própria — Explorador, Pesquisa, Editor e muito mais. Crie sua primeira aba.</string>
    <string name="tour_manager_fab_title">Atalhos rápidos</string>
    <string name="tour_manager_fab_body">Toque aqui para ver atalhos para as ferramentas que você mais usa e para fechar todas as abas de uma vez.</string>
    <string name="tour_manager_reorder_title">Reordene suas abas</string>
    <string name="tour_manager_reorder_body">Toque e segure a barra de título de uma aba e arraste-a para onde quiser. Essa é a ordem em que suas abas aparecem em todos os outros lugares.</string>
    <string name="tour_manager_select_title">Trabalhe em várias abas</string>
    <string name="tour_manager_select_body">Toque e segure a prévia de uma aba para começar a selecionar abas. Depois toque nas demais e feche ou pause todas de uma vez.</string>
