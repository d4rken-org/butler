    <string name="workspace_classic_empty_tip">Dica: toca em “Criar separador” e escolhe uma ferramenta — Explorador, Pesquisa, Editor e muito mais.</string>

    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">Começa com um separador</string>
    <string name="tour_first_tab_body">O Butler funciona com separadores, como um navegador: cada um é uma ferramenta distinta — Explorador, Pesquisa, Editor e muito mais. Cria o teu primeiro separador.</string>
    <string name="tour_manager_fab_title">Atalhos rápidos</string>
    <string name="tour_manager_fab_body">Toca aqui para aceder a atalhos para as ferramentas que mais usas e para fechar todos os separadores de uma só vez.</string>
    <string name="tour_manager_reorder_title">Reordena os teus separadores</string>
    <string name="tour_manager_reorder_body">Mantém premida a barra de título de um separador e arrasta-o para onde quiseres. Esta é a ordem em que os teus separadores aparecem em todo o lado.</string>
    <string name="tour_manager_select_title">Trabalha em vários separadores</string>
    <string name="tour_manager_select_body">Mantém premida a pré-visualização de um separador para começar a selecionar separadores. Depois toca nos restantes e fecha-os ou coloca-os em pausa de uma só vez.</string>
    <string name="tour_manager_new_tab_title">Abre um novo separador</string>
    <string name="tour_manager_new_tab_body">Toca neste cartão para escolher uma ferramenta para um novo separador.</string>
    <string name="tour_swipe_switch_title">Desliza entre separadores</string>
    <string name="tour_swipe_switch_body">Desliza para a esquerda ou para a direita em qualquer parte da página para alternar entre os teus separadores abertos.</string>
    <string name="tour_swipe_create_title">Desliza para abrir um separador</string>
    <string name="tour_swipe_create_body">Desliza para além do último separador e o Butler oferece-te um novo.</string>
    <string name="tour_swipe_panes_title">Mais do que um separador de cada vez</string>
    <string name="tour_swipe_panes_body">Num ecrã maior ou na horizontal, o Butler mostra vários separadores lado a lado. As definições de disposição em Separadores determinam quando isso acontece.</string>
    <string name="tour_panes_rail_title">Todos os teus separadores</string>
    <string name="tour_panes_rail_body">Todos os separadores abertos estão aqui. Toca num e escolhe o painel para onde deve ir. Mantém premido um separador e arrasta-o para alterar a ordem.</string>
    <string name="tour_panes_divider_title">Redimensiona os painéis</string>
    <string name="tour_panes_divider_body">Arrasta esta divisória para dar mais espaço a um painel.</string>
    <string name="tour_panes_layout_title">Altera a disposição</string>
    <string name="tour_panes_layout_body">Toca no botão do Butler e escolhe Disposição para reorganizar os painéis. As definições de Separadores fixam uma disposição para cada orientação.</string>

