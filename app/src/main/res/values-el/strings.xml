    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">Ξεκινήστε με μια καρτέλα</string>
    <string name="tour_first_tab_body">Το Butler λειτουργεί σε καρτέλες, όπως ένα πρόγραμμα περιήγησης: η καθεμία είναι ένα ξεχωριστό εργαλείο — Εξερεύνηση, Αναζήτηση, Επεξεργαστής και άλλα. Δημιουργήστε την πρώτη σας καρτέλα.</string>
    <string name="tour_manager_fab_title">Γρήγορες συντομεύσεις</string>
    <string name="tour_manager_fab_body">Πατήστε εδώ για συντομεύσεις στα εργαλεία που χρησιμοποιείτε περισσότερο, και για να κλείσετε όλες τις καρτέλες μονομιάς.</string>
    <string name="tour_manager_reorder_title">Αναδιάταξη των καρτελών σας</string>
    <string name="tour_manager_reorder_body">Πατήστε παρατεταμένα τη γραμμή τίτλου μιας καρτέλας και μετά σύρτε την όπου θέλετε. Αυτή είναι η σειρά με την οποία εμφανίζονται οι καρτέλες σας παντού αλλού.</string>
    <string name="tour_manager_select_title">Δουλέψτε σε πολλές καρτέλες</string>
    <string name="tour_manager_select_body">Πατήστε παρατεταμένα την προεπισκόπηση μιας καρτέλας για να ξεκινήσετε την επιλογή καρτελών. Μετά πατήστε τις υπόλοιπες και κλείστε ή θέστε τις όλες σε παύση με μία κίνηση.</string>
    <string name="tour_manager_new_tab_title">Ξεκινήστε μια νέα καρτέλα</string>
    <string name="tour_manager_new_tab_body">Πατήστε αυτή την κάρτα για να επιλέξετε οποιοδήποτε εργαλείο για μια νέα καρτέλα.</string>
    <string name="tour_swipe_switch_title">Σύρετε για εναλλαγή καρτελών</string>
    <string name="tour_swipe_switch_body">Σύρτε αριστερά ή δεξιά οπουδήποτε στη σελίδα για να μετακινηθείτε μεταξύ των ανοιχτών σας καρτελών.</string>
    <string name="tour_swipe_create_title">Σύρετε για να ξεκινήσετε μια καρτέλα</string>
    <string name="tour_swipe_create_body">Σύρτε πέρα από την τελευταία σας καρτέλα και το Butler σας προσφέρει μια καινούρια.</string>
    <string name="tour_swipe_panes_title">Περισσότερες από μία καρτέλα ταυτόχρονα</string>
    <string name="tour_swipe_panes_body">Σε μεγαλύτερη οθόνη, ή σε οριζόντιο προσανατολισμό, το Butler εμφανίζει πολλές καρτέλες δίπλα-δίπλα. Οι ρυθμίσεις διάταξης στις Καρτέλες καθορίζουν πότε συμβαίνει αυτό.</string>
    <string name="tour_panes_rail_title">Όλες οι καρτέλες σας</string>
    <string name="tour_panes_rail_body">Κάθε ανοιχτή καρτέλα βρίσκεται εδώ. Πατήστε μία και επιλέξτε το τμήμα στο οποίο θα πάει. Πατήστε παρατεταμένα μια καρτέλα και μετά σύρτε την για να αλλάξετε τη σειρά τους.</string>
    <string name="tour_panes_divider_title">Αλλαγή μεγέθους τμημάτων</string>
    <string name="tour_panes_divider_body">Σύρτε αυτόν τον διαχωριστή για να δώσετε σε ένα τμήμα περισσότερο χώρο.</string>
    <string name="tour_panes_layout_title">Αλλάξτε τη διάταξη</string>
    <string name="tour_panes_layout_body">Πατήστε το κουμπί Butler και επιλέξτε Διάταξη για να αναδιατάξετε τα τμήματα. Οι ρυθμίσεις Καρτελών ορίζουν μια σταθερή διάταξη ανά προσανατολισμό.</string>

