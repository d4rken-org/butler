    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">ابدأ بعلامة تبويب</string>
    <string name="tour_first_tab_body">يعمل Butler بعلامات التبويب، مثل المتصفح: كل واحدة أداة قائمة بذاتها — المستكشف، البحث، المحرر، والمزيد. أنشئ أول علامة تبويب لك.</string>
    <string name="tour_manager_fab_title">اختصارات سريعة</string>
    <string name="tour_manager_fab_body">اضغط هنا للوصول إلى اختصارات الأدوات التي تستخدمها أكثر، ولإغلاق جميع علامات التبويب دفعة واحدة.</string>
    <string name="tour_manager_reorder_title">أعد ترتيب علامات التبويب</string>
    <string name="tour_manager_reorder_body">اضغط مع الاستمرار على شريط عنوان علامة التبويب، ثم اسحبها إلى حيث تريد. هذا هو الترتيب الذي ستظهر به علامات التبويب في كل مكان آخر.</string>
    <string name="tour_manager_select_title">اعمل على عدة علامات تبويب</string>
    <string name="tour_manager_select_body">اضغط مع الاستمرار على معاينة علامة التبويب لبدء اختيار علامات التبويب. ثم اضغط على البقية وأغلقها أو أوقفها مؤقتًا جميعًا دفعة واحدة.</string>
    <string name="tour_manager_new_tab_title">ابدأ علامة تبويب جديدة</string>
    <string name="tour_manager_new_tab_body">اضغط على هذه البطاقة لاختيار أي أداة لعلامة تبويب جديدة.</string>
    <string name="tour_swipe_switch_title">مرر بين علامات التبويب</string>
    <string name="tour_swipe_switch_body">مرر يمينًا أو يسارًا في أي مكان على الصفحة للتنقل بين علامات التبويب المفتوحة.</string>
    <string name="tour_swipe_create_title">مرر لبدء علامة تبويب</string>
    <string name="tour_swipe_create_body">مرر متجاوزًا آخر علامة تبويب، ويعرض عليك Butler علامة تبويب جديدة.</string>
    <string name="tour_swipe_panes_title">أكثر من علامة تبويب في آن واحد</string>
    <string name="tour_swipe_panes_body">على شاشة أكبر، أو في الوضع الأفقي، يعرض Butler عدة علامات تبويب جنبًا إلى جنب. تحدّد إعدادات التخطيط ضمن علامات التبويب متى يحدث ذلك.</string>
    <string name="tour_panes_rail_title">جميع علامات التبويب الخاصة بك</string>
    <string name="tour_panes_rail_body">توجد هنا كل علامة تبويب مفتوحة. اضغط على واحدة واختر اللوحة التي يجب أن تنتقل إليها. اضغط مع الاستمرار على علامة تبويب، ثم اسحبها، لتغيير ترتيبها.</string>
    <string name="tour_panes_divider_title">غيّر حجم اللوحات</string>
    <string name="tour_panes_divider_body">اسحب هذا الفاصل لمنح إحدى اللوحات مساحة أكبر.</string>
    <string name="tour_panes_layout_title">غيّر الترتيب</string>
    <string name="tour_panes_layout_body">اضغط على زر Butler واختر التخطيط لإعادة ترتيب اللوحات. تُثبّت إعدادات علامات التبويب تخطيطًا لكل اتجاه.</string>

