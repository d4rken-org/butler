    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">Inizia con una scheda</string>
    <string name="tour_first_tab_body">Butler funziona a schede, come un browser: ognuna è uno strumento a sé — Explorer, Ricerca, Editor e altro. Crea la tua prima scheda.</string>
    <string name="tour_manager_fab_title">Scorciatoie rapide</string>
    <string name="tour_manager_fab_body">Tocca qui per le scorciatoie agli strumenti che usi di più e per chiudere tutte le schede in una volta.</string>
    <string name="tour_manager_reorder_title">Riordina le tue schede</string>
    <string name="tour_manager_reorder_body">Tieni premuta la barra del titolo di una scheda, poi trascinala dove preferisci. Questo è l’ordine in cui le tue schede appaiono ovunque.</string>
    <string name="tour_manager_select_title">Lavora su più schede</string>
    <string name="tour_manager_select_body">Tieni premuta l’anteprima di una scheda per iniziare a selezionarle. Poi tocca le altre e chiudile o mettile in pausa tutte insieme.</string>
    <string name="tour_manager_new_tab_title">Avvia una nuova scheda</string>
    <string name="tour_manager_new_tab_body">Tocca questo riquadro per scegliere uno strumento per una nuova scheda.</string>
    <string name="tour_swipe_switch_title">Scorri tra le schede</string>
    <string name="tour_swipe_switch_body">Scorri a sinistra o a destra in un punto qualsiasi della pagina per spostarti tra le schede aperte.</string>
    <string name="tour_swipe_create_title">Scorri per avviare una scheda</string>
    <string name="tour_swipe_create_body">Scorri oltre l’ultima scheda e Butler te ne offre una nuova.</string>
    <string name="tour_swipe_panes_title">Più di una scheda alla volta</string>
    <string name="tour_swipe_panes_body">Su uno schermo più grande, o in orizzontale, Butler mostra più schede affiancate. Le impostazioni del layout in Schede stabiliscono quando questo avviene.</string>
    <string name="tour_panes_rail_title">Tutte le tue schede</string>
    <string name="tour_panes_rail_body">Qui trovi tutte le schede aperte. Toccane una e scegli il riquadro a cui assegnarla. Tieni premuta una scheda, poi trascinala, per cambiarne l’ordine.</string>
    <string name="tour_panes_divider_title">Ridimensiona i riquadri</string>
    <string name="tour_panes_divider_body">Trascina questo separatore per dare più spazio a un riquadro.</string>
    <string name="tour_panes_layout_title">Cambia la disposizione</string>
    <string name="tour_panes_layout_body">Tocca il pulsante Butler e scegli Layout per riorganizzare i riquadri. Le impostazioni Schede fissano un layout per ogni orientamento.</string>

