    <!-- Không gian làm việc > Hướng dẫn -->
    <string name="tour_first_tab_title">Bắt đầu với một thẻ</string>
    <string name="tour_first_tab_body">Butler hoạt động theo thẻ, giống như trình duyệt: mỗi thẻ là một công cụ riêng — Trình duyệt tệp, Tìm kiếm, Trình soạn thảo và nhiều hơn nữa. Hãy tạo thẻ đầu tiên của bạn.</string>
    <string name="tour_manager_fab_title">Lối tắt nhanh</string>
    <string name="tour_manager_fab_body">Nhấn vào đây để có lối tắt đến các công cụ bạn dùng nhiều nhất, và để đóng tất cả thẻ cùng lúc.</string>
    <string name="tour_manager_reorder_title">Sắp xếp lại thẻ của bạn</string>
    <string name="tour_manager_reorder_body">Nhấn giữ thanh tiêu đề của một thẻ, sau đó kéo đến vị trí bạn muốn. Đây cũng là thứ tự thẻ xuất hiện ở mọi nơi khác.</string>
    <string name="tour_manager_select_title">Thao tác trên nhiều thẻ</string>
    <string name="tour_manager_select_body">Nhấn giữ hình xem trước của một thẻ để bắt đầu chọn thẻ. Sau đó nhấn vào các thẻ còn lại và đóng hoặc tạm dừng tất cả cùng lúc.</string>
    <string name="tour_manager_new_tab_title">Bắt đầu một thẻ mới</string>
    <string name="tour_manager_new_tab_body">Nhấn vào thẻ này để chọn bất kỳ công cụ nào cho một thẻ mới.</string>
    <string name="tour_swipe_switch_title">Vuốt để chuyển thẻ</string>
    <string name="tour_swipe_switch_body">Vuốt sang trái hoặc phải ở bất kỳ đâu trên trang để chuyển giữa các thẻ đang mở.</string>
    <string name="tour_swipe_create_title">Vuốt để tạo thẻ mới</string>
    <string name="tour_swipe_create_body">Vuốt qua thẻ cuối cùng và Butler sẽ đề nghị tạo cho bạn một thẻ mới.</string>
    <string name="tour_swipe_panes_title">Nhiều hơn một thẻ cùng lúc</string>
    <string name="tour_swipe_panes_body">Trên màn hình lớn hơn, hoặc ở chế độ ngang, Butler hiển thị nhiều thẻ cạnh nhau. Cài đặt bố cục trong mục Thẻ quyết định khi nào điều này xảy ra.</string>
    <string name="tour_panes_rail_title">Tất cả thẻ của bạn</string>
    <string name="tour_panes_rail_body">Mọi thẻ đang mở đều nằm ở đây. Nhấn vào một thẻ và chọn khung mà nó sẽ chuyển đến. Nhấn giữ một thẻ rồi kéo để thay đổi thứ tự.</string>
    <string name="tour_panes_divider_title">Thay đổi kích thước khung</string>
    <string name="tour_panes_divider_body">Kéo thanh chia này để nhường thêm không gian cho một khung.</string>
    <string name="tour_panes_layout_title">Thay đổi cách sắp xếp</string>
    <string name="tour_panes_layout_body">Nhấn nút Butler và chọn Bố cục để sắp xếp lại các khung. Cài đặt Thẻ sẽ ghim một bố cục riêng cho mỗi hướng màn hình.</string>

