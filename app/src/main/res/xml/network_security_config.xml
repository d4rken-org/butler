<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext for plain http:// WebDAV servers. System trust anchors only, no user CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
