    <!-- 작업 영역 > 가이드 투어 -->
    <string name="tour_first_tab_title">탭으로 시작하기</string>
    <string name="tour_first_tab_body">Butler는 브라우저처럼 탭으로 동작합니다. 각 탭은 탐색기, 검색, 편집기 등 하나의 독립된 도구입니다. 첫 탭을 만들어보십시오.</string>
    <string name="tour_manager_fab_title">빠른 바로가기</string>
    <string name="tour_manager_fab_body">자주 쓰는 도구의 바로가기를 보거나 모든 탭을 한 번에 닫으려면 이걸 탭하십시오.</string>
    <string name="tour_manager_reorder_title">탭 순서 바꾸기</string>
    <string name="tour_manager_reorder_body">탭의 제목 표시줄을 길게 눌러 원하는 위치로 드래그하십시오. 이 순서는 다른 곳에서도 그대로 적용됩니다.</string>
    <string name="tour_manager_select_title">여러 탭 한꺼번에 다루기</string>
    <string name="tour_manager_select_body">탭 미리보기를 길게 눌러 탭 선택을 시작하십시오. 나머지를 탭한 다음 한 번에 닫거나 일시중지할 수 있습니다.</string>
    <string name="tour_manager_new_tab_title">새 탭 시작하기</string>
    <string name="tour_manager_new_tab_body">이 카드를 탭해 새 탭에 사용할 도구를 선택하십시오.</string>
    <string name="tour_swipe_switch_title">스와이프로 탭 전환</string>
    <string name="tour_swipe_switch_body">화면 어디서든 좌우로 스와이프해 열린 탭 사이를 이동하십시오.</string>
    <string name="tour_swipe_create_title">스와이프로 탭 시작하기</string>
    <string name="tour_swipe_create_body">마지막 탭을 지나 스와이프하면 Butler가 새 탭을 제안합니다.</string>
    <string name="tour_swipe_panes_title">한 번에 여러 탭 보기</string>
    <string name="tour_swipe_panes_body">화면이 크거나 가로 모드일 때 Butler는 여러 탭을 나란히 보여줍니다. 이 동작 시점은 탭 설정의 레이아웃 항목에서 결정됩니다.</string>
    <string name="tour_panes_rail_title">모든 탭 한눈에</string>
    <string name="tour_panes_rail_body">열린 탭이 모두 여기에 있습니다. 탭을 선택하고 이동할 패널을 고르십시오. 탭을 길게 눌러 드래그하면 순서를 바꿀 수 있습니다.</string>
    <string name="tour_panes_divider_title">패널 크기 조절</string>
    <string name="tour_panes_divider_body">이 구분선을 드래그해 한 패널에 더 많은 공간을 주십시오.</string>
    <string name="tour_panes_layout_title">배치 바꾸기</string>
    <string name="tour_panes_layout_body">Butler 버튼을 탭하고 레이아웃을 선택해 패널 배치를 바꾸십시오. 탭 설정에서 화면 방향별로 레이아웃을 고정할 수 있습니다.</string>

