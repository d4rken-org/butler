    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">Počni s karticom</string>
    <string name="tour_first_tab_body">Butler radi u karticama, kao preglednik: svaka je zaseban alat — Preglednik datoteka, Pretraživanje, Uređivač i drugi. Stvori svoju prvu karticu.</string>
    <string name="tour_manager_fab_title">Brzi prečaci</string>
    <string name="tour_manager_fab_body">Dodirni ovdje za prečace do alata koje najviše upotrebljavaš i za zatvaranje svih kartica odjednom.</string>
    <string name="tour_manager_reorder_title">Promijeni redoslijed kartica</string>
    <string name="tour_manager_reorder_body">Pritisni i zadrži naslovnu traku kartice, a zatim je povuci kamo želiš. Tim će se redoslijedom tvoje kartice prikazivati i svugdje drugdje.</string>
    <string name="tour_manager_select_title">Radi na više kartica</string>
    <string name="tour_manager_select_body">Pritisni i zadrži pretpregled kartice da počneš odabirati kartice. Zatim dodirni ostale i zatvori ih ili pauziraj sve odjednom.</string>
    <string name="tour_manager_new_tab_title">Otvori novu karticu</string>
    <string name="tour_manager_new_tab_body">Dodirni ovu pločicu da odabereš bilo koji alat za novu karticu.</string>
    <string name="tour_swipe_switch_title">Prelazi među karticama povlačenjem</string>
    <string name="tour_swipe_switch_body">Povuci lijevo ili desno bilo gdje na stranici da prijeđeš na drugu otvorenu karticu.</string>
    <string name="tour_swipe_create_title">Povuci za novu karticu</string>
    <string name="tour_swipe_create_body">Povuci dalje od posljednje kartice i Butler će ti ponuditi novu.</string>
    <string name="tour_swipe_panes_title">Više kartica odjednom</string>
    <string name="tour_swipe_panes_body">Na većem zaslonu ili u vodoravnom položaju Butler prikazuje više kartica jednu uz drugu. Postavke rasporeda u odjeljku Kartice određuju kada se to događa.</string>
    <string name="tour_panes_rail_title">Sve tvoje kartice</string>
    <string name="tour_panes_rail_body">Ovdje su sve otvorene kartice. Dodirni jednu i odaberi okno u koje će se smjestiti. Pritisni i zadrži karticu, a zatim je povuci da promijeniš njihov redoslijed.</string>
    <string name="tour_panes_divider_title">Promijeni veličinu okana</string>
    <string name="tour_panes_divider_body">Povuci ovaj razdjelnik da jednom oknu daš više prostora.</string>
    <string name="tour_panes_layout_title">Promijeni raspored</string>
    <string name="tour_panes_layout_body">Dodirni gumb Butler i odaberi Raspored da prerasporediš okna. Postavke u odjeljku Kartice omogućuju postavljanje stalnog rasporeda za svaki položaj zaslona.</string>

