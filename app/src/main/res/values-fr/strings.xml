    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">Commencez par un onglet</string>
    <string name="tour_first_tab_body">Butler fonctionne avec des onglets, comme un navigateur : chacun est un outil à part entière — Explorateur, Recherche, Éditeur, et plus encore. Créez votre premier onglet.</string>
    <string name="tour_manager_fab_title">Raccourcis rapides</string>
    <string name="tour_manager_fab_body">Touchez ceci pour accéder rapidement aux outils que vous utilisez le plus, et pour fermer tous les onglets en une fois.</string>
    <string name="tour_manager_reorder_title">Réorganisez vos onglets</string>
    <string name="tour_manager_reorder_body">Maintenez la barre de titre d’un onglet, puis faites-le glisser à l’endroit voulu. C’est dans cet ordre que vos onglets apparaissent partout ailleurs.</string>
    <string name="tour_manager_select_title">Travaillez sur plusieurs onglets</string>
    <string name="tour_manager_select_body">Maintenez l’aperçu d’un onglet pour commencer à en sélectionner. Touchez ensuite les autres, puis fermez-les ou mettez-les en pause en une seule fois.</string>
    <string name="tour_manager_new_tab_title">Démarrez un nouvel onglet</string>
    <string name="tour_manager_new_tab_body">Touchez cette carte pour choisir n’importe quel outil pour un nouvel onglet.</string>
    <string name="tour_swipe_switch_title">Balayez entre les onglets</string>
    <string name="tour_swipe_switch_body">Balayez vers la gauche ou la droite n’importe où sur la page pour naviguer entre vos onglets ouverts.</string>
    <string name="tour_swipe_create_title">Balayez pour démarrer un onglet</string>
    <string name="tour_swipe_create_body">Balayez au-delà de votre dernier onglet et Butler vous en propose un nouveau.</string>
    <string name="tour_swipe_panes_title">Plus d’un onglet à la fois</string>
    <string name="tour_swipe_panes_body">Sur un écran plus grand, ou en mode paysage, Butler affiche plusieurs onglets côte à côte. Les paramètres de disposition sous Onglets déterminent quand cela se produit.</string>
    <string name="tour_panes_rail_title">Tous vos onglets</string>
    <string name="tour_panes_rail_body">Tous les onglets ouverts se trouvent ici. Touchez-en un et choisissez le panneau où il doit aller. Maintenez un onglet, puis faites-le glisser, pour changer leur ordre.</string>
    <string name="tour_panes_divider_title">Redimensionnez les panneaux</string>
    <string name="tour_panes_divider_body">Faites glisser ce séparateur pour donner plus d’espace à un panneau.</string>
    <string name="tour_panes_layout_title">Changez la disposition</string>
    <string name="tour_panes_layout_body">Touchez le bouton Butler et choisissez Disposition pour réorganiser les panneaux. Les paramètres Onglets fixent une disposition par orientation.</string>

