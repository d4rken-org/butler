    <string name="setup_title">Configuración de permisos</string>
    <string name="setup_settings_description">Configura los permisos y funciones de la aplicación.</string>
    <string name="setup_help_description">Ayuda</string>

    <string name="setup_root_description">Habilita el acceso a archivos del sistema y directorios protegidos para una gestión de archivos avanzada. Desbloquea todo el potencial de Butler, incluido el acceso a datos de aplicaciones y modificaciones del sistema. El dispositivo debe tener root.</string>
    <string name="setup_shizuku_description">Alternativa a root que ofrece operaciones de archivos con privilegios mediante una API segura. Permite acceder a directorios restringidos sin necesidad de root tradicional. Requiere que la aplicación Shizuku esté instalada y en ejecución.</string>
    <string name="setup_notification_description">Muestra actualizaciones de las operaciones de archivos, tareas en segundo plano y progreso de transferencias. Te mantiene informado cuando las operaciones finalizan o se producen errores.</string>
    <string name="setup_usagestats_description">Analiza el uso de almacenamiento de las aplicaciones para identificar archivos grandes y ayudarte a administrar el espacio de forma eficaz. Todos los datos permanecen en tu dispositivo y nunca se transmiten.</string>
    <string name="setup_storage_description">Acceso completo a todo el almacenamiento del dispositivo para operaciones de archivos rápidas y procesamiento por lotes. Permite una gestión de archivos completa sin solicitudes de permiso repetidas.</string>
    <string name="setup_inventory_description">Consulta todas las aplicaciones instaladas para funciones como la extracción de APK y el análisis de almacenamiento. Necesario en Android 11 o superior para ver la lista completa de aplicaciones.</string>

