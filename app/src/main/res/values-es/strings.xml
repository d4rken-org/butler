    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">Empieza con una pestaña</string>
    <string name="tour_first_tab_body">Butler funciona con pestañas, como un navegador: cada una es una herramienta en sí misma (Explorador, Búsqueda, Editor y más). Crea tu primera pestaña.</string>
    <string name="tour_manager_fab_title">Accesos rápidos</string>
    <string name="tour_manager_fab_body">Toca aquí para acceder rápidamente a las herramientas que más usas y para cerrar todas las pestañas a la vez.</string>
    <string name="tour_manager_reorder_title">Reordena tus pestañas</string>
    <string name="tour_manager_reorder_body">Mantén pulsada la barra de título de una pestaña y arrástrala adonde quieras. Este es el orden en que aparecerán tus pestañas en todos los demás lugares.</string>
    <string name="tour_manager_select_title">Trabaja en varias pestañas</string>
    <string name="tour_manager_select_body">Mantén pulsada la vista previa de una pestaña para empezar a seleccionar pestañas. Luego toca el resto y ciérralas o ponlas todas en pausa a la vez.</string>
    <string name="tour_manager_new_tab_title">Inicia una nueva pestaña</string>
    <string name="tour_manager_new_tab_body">Toca esta tarjeta para elegir cualquier herramienta para una nueva pestaña.</string>
    <string name="tour_swipe_switch_title">Desliza entre pestañas</string>
    <string name="tour_swipe_switch_body">Desliza hacia la izquierda o la derecha en cualquier parte de la página para moverte entre tus pestañas abiertas.</string>
    <string name="tour_swipe_create_title">Desliza para iniciar una pestaña</string>
    <string name="tour_swipe_create_body">Desliza más allá de tu última pestaña y Butler te ofrecerá una nueva.</string>
    <string name="tour_swipe_panes_title">Más de una pestaña a la vez</string>
    <string name="tour_swipe_panes_body">En una pantalla más grande, o en horizontal, Butler muestra varias pestañas una junto a otra. La configuración de diseño en Pestañas determina cuándo sucede esto.</string>
    <string name="tour_panes_rail_title">Todas tus pestañas</string>
    <string name="tour_panes_rail_body">Aquí se encuentran todas las pestañas abiertas. Toca una y elige el panel al que debe ir. Mantén pulsada una pestaña y arrástrala para cambiar su orden.</string>
    <string name="tour_panes_divider_title">Cambia el tamaño de los paneles</string>
    <string name="tour_panes_divider_body">Arrastra este divisor para darle más espacio a un panel.</string>
    <string name="tour_panes_layout_title">Cambia la disposición</string>
    <string name="tour_panes_layout_body">Toca el botón de Butler y elige Diseño para reorganizar los paneles. La configuración de Pestañas fija un diseño para cada orientación.</string>

