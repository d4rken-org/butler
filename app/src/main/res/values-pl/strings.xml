    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">Zacznij od karty</string>
    <string name="tour_first_tab_body">Butler działa w kartach, jak przeglądarka: każda z nich to osobne narzędzie — Eksplorator, Wyszukiwanie, Edytor i inne. Utwórz swoją pierwszą kartę.</string>
    <string name="tour_manager_fab_title">Szybkie skróty</string>
    <string name="tour_manager_fab_body">Dotknij, aby uzyskać skróty do najczęściej używanych narzędzi i zamknąć wszystkie karty naraz.</string>
    <string name="tour_manager_reorder_title">Zmień kolejność kart</string>
    <string name="tour_manager_reorder_body">Naciśnij i przytrzymaj pasek tytułowy karty, a następnie przeciągnij ją w wybrane miejsce. To ta sama kolejność, w jakiej karty pojawiają się wszędzie indziej.</string>
    <string name="tour_manager_select_title">Pracuj na kilku kartach</string>
    <string name="tour_manager_select_body">Naciśnij i przytrzymaj podgląd karty, aby rozpocząć wybieranie kart. Następnie dotknij pozostałych i zamknij lub wstrzymaj je wszystkie naraz.</string>
    <string name="tour_manager_new_tab_title">Utwórz nową kartę</string>
    <string name="tour_manager_new_tab_body">Dotknij tej karty, aby wybrać dowolne narzędzie dla nowej karty.</string>
    <string name="tour_swipe_switch_title">Przesuwaj między kartami</string>
    <string name="tour_swipe_switch_body">Przesuń palcem w lewo lub w prawo w dowolnym miejscu strony, aby przełączać się między otwartymi kartami.</string>
    <string name="tour_swipe_create_title">Przesuń, aby utworzyć kartę</string>
    <string name="tour_swipe_create_body">Przesuń poza ostatnią kartę, a Butler zaproponuje nową.</string>
    <string name="tour_swipe_panes_title">Więcej niż jedna karta naraz</string>
    <string name="tour_swipe_panes_body">Na większym ekranie lub w orientacji poziomej Butler pokazuje kilka kart obok siebie. Ustawienia układu w sekcji Karty decydują, kiedy to następuje.</string>
    <string name="tour_panes_rail_title">Wszystkie Twoje karty</string>
    <string name="tour_panes_rail_body">Tutaj znajdują się wszystkie otwarte karty. Dotknij jednej i wybierz panel, do którego ma trafić. Naciśnij i przytrzymaj kartę, a następnie przeciągnij ją, aby zmienić kolejność.</string>
    <string name="tour_panes_divider_title">Zmień rozmiar paneli</string>
    <string name="tour_panes_divider_body">Przeciągnij ten separator, aby dać jednemu panelowi więcej miejsca.</string>
    <string name="tour_panes_layout_title">Zmień układ</string>
    <string name="tour_panes_layout_body">Dotknij przycisku Butler i wybierz Układ, aby zmienić rozmieszczenie paneli. Ustawienia Karty przypisują układ do każdej orientacji.</string>

