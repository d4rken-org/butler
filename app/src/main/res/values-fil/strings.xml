    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">Magsimula sa isang tab</string>
    <string name="tour_first_tab_body">Gumagana ang Butler sa mga tab, tulad ng browser: bawat isa ay may sariling kasangkapan — Explorer, Paghahanap, Editor, at iba pa. Gumawa ng iyong unang tab.</string>
    <string name="tour_manager_fab_title">Mga mabilisang shortcut</string>
    <string name="tour_manager_fab_body">I-tap ito para sa mga shortcut sa mga kasangkapang pinakamadalas mong gamitin, at upang isara ang lahat ng tab nang sabay-sabay.</string>
    <string name="tour_manager_reorder_title">Ayusin ang pagkakasunod ng iyong mga tab</string>
    <string name="tour_manager_reorder_body">Pindutin nang matagal ang title bar ng isang tab, at i-drag ito sa gusto mong lugar. Ito ang magiging pagkakasunod ng mga tab sa lahat ng iba pang lugar.</string>
    <string name="tour_manager_select_title">Gumawa sa ilang tab</string>
    <string name="tour_manager_select_body">Pindutin nang matagal ang preview ng isang tab upang simulan ang pagpili ng mga tab. Pagkatapos, i-tap ang iba at isara o i-pause silang lahat nang sabay-sabay.</string>
    <string name="tour_manager_new_tab_title">Magsimula ng bagong tab</string>
    <string name="tour_manager_new_tab_body">I-tap ang card na ito upang pumili ng anumang kasangkapan para sa bagong tab.</string>
    <string name="tour_swipe_switch_title">Mag-swipe sa pagitan ng mga tab</string>
    <string name="tour_swipe_switch_body">Mag-swipe pakaliwa o pakanan saanman sa pahina upang lumipat sa pagitan ng iyong mga bukas na tab.</string>
    <string name="tour_swipe_create_title">Mag-swipe upang magsimula ng tab</string>
    <string name="tour_swipe_create_body">Mag-swipe lampas sa iyong huling tab at mag-aalok ang Butler ng bago.</string>
    <string name="tour_swipe_panes_title">Higit sa isang tab sa isang pagkakataon</string>
    <string name="tour_swipe_panes_body">Sa mas malaking screen, o kapag nakapahalang, nagpapakita ang Butler ng ilang tab nang magkakatabi. Itinatakda ng mga setting ng layout sa ilalim ng Mga tab kung kailan ito mangyayari.</string>
    <string name="tour_panes_rail_title">Lahat ng iyong tab</string>
    <string name="tour_panes_rail_body">Nandito ang bawat bukas na tab. I-tap ang isa at piliin ang panel na paglalagyan nito. Pindutin nang matagal ang isang tab at i-drag ito upang baguhin ang pagkakasunod.</string>
    <string name="tour_panes_divider_title">Baguhin ang laki ng mga panel</string>
    <string name="tour_panes_divider_body">I-drag ang panghating ito upang bigyan ng mas malaking espasyo ang isang panel.</string>
