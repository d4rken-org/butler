    <string name="setup_title">Pag-setup ng mga pahintulot</string>
    <string name="setup_settings_description">I-configure ang mga pahintulot at feature ng app.</string>
    <string name="setup_help_description">Tulong</string>

    <string name="setup_root_description">Nagbibigay ng pag-access sa mga file ng system at protektadong direktoryo para sa mas advanced na pamamahala ng mga file. Binubuksan ang buong kakayahan ng Butler, kabilang ang pag-access sa data ng app at pagbabago sa system. Kailangang naka-root ang device.</string>
    <string name="setup_shizuku_description">Alternatibo sa root na nagbibigay ng mga pribilehiyadong operasyon sa file sa pamamagitan ng ligtas na API. Nagbibigay ng pag-access sa mga pinaghihigpitang direktoryo nang walang tradisyonal na root. Kailangang naka-install at tumatakbo ang Porter o Shizuku.</string>
    <string name="setup_notification_description">Nagpapakita ng mga update sa mga operasyon sa file, gawain sa background, at progreso ng paglilipat. Ipinapaalam kung nakumpleto na ang mga operasyon o may naganap na error.</string>
    <string name="setup_usagestats_description">Sinusuri ang paggamit ng storage ng mga app upang matukoy ang malalaking file at makatulong sa mahusay na pamamahala ng espasyo. Lahat ng data ay nananatili sa iyong device at hindi kailanman ipinapadala.</string>
    <string name="setup_storage_description">Buong pag-access sa lahat ng storage ng device para sa mabilis na mga operasyon sa file at maramihang pagproseso. Nagbibigay-daan sa komprehensibong pamamahala ng mga file nang walang paulit-ulit na paghingi ng pahintulot.</string>
    <string name="setup_inventory_description">Makita ang lahat ng naka-install na app para sa mga feature tulad ng pagkuha ng APK at pagsusuri ng storage. Kailangan sa Android 11+ para makita ang buong listahan ng app.</string>

