    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">Start med en fane</string>
    <string name="tour_first_tab_body">Butler fungerer med faner, ligesom en browser: Hver fane er sit eget værktøj — Filhåndterer, Søgning, Tekstredigering og flere. Opret din første fane.</string>
    <string name="tour_manager_fab_title">Hurtige genveje</string>
    <string name="tour_manager_fab_body">Tryk her for genveje til de værktøjer, du bruger mest, og for at lukke alle faner på én gang.</string>
    <string name="tour_manager_reorder_title">Omarranger dine faner</string>
    <string name="tour_manager_reorder_body">Tryk og hold på en fanes titellinje, og træk den så hen, hvor du vil have den. Det er den rækkefølge, dine faner vises i alle andre steder.</string>
    <string name="tour_manager_select_title">Arbejd med flere faner</string>
    <string name="tour_manager_select_body">Tryk og hold på en fanes forhåndsvisning for at begynde at vælge faner. Tryk derefter på resten, og luk eller sæt dem alle på pause på én gang.</string>
    <string name="tour_manager_new_tab_title">Start en ny fane</string>
    <string name="tour_manager_new_tab_body">Tryk på dette kort for at vælge et hvilket som helst værktøj til en ny fane.</string>
    <string name="tour_swipe_switch_title">Stryg mellem faner</string>
    <string name="tour_swipe_switch_body">Stryg til venstre eller højre hvor som helst på siden for at skifte mellem dine åbne faner.</string>
    <string name="tour_swipe_create_title">Stryg for at starte en fane</string>
    <string name="tour_swipe_create_body">Stryg forbi din sidste fane, så tilbyder Butler dig en ny.</string>
    <string name="tour_swipe_panes_title">Mere end én fane ad gangen</string>
    <string name="tour_swipe_panes_body">På en større skærm eller i liggende retning viser Butler flere faner side om side. Layoutindstillingerne under Faner bestemmer, hvornår det sker.</string>
    <string name="tour_panes_rail_title">Alle dine faner</string>
    <string name="tour_panes_rail_body">Alle åbne faner findes her. Tryk på en fane, og vælg den rude, den skal vises i. Tryk og hold på en fane, og træk den så for at ændre rækkefølgen.</string>
    <string name="tour_panes_divider_title">Tilpas rudernes størrelse</string>
    <string name="tour_panes_divider_body">Træk i denne skillelinje for at give en rude mere plads.</string>
    <string name="tour_panes_layout_title">Skift opstilling</string>
    <string name="tour_panes_layout_body">Tryk på Butler-knappen, og vælg Layout for at omarrangere ruderne. Indstillingerne for Faner fastlægger et layout for hver skærmretning.</string>

