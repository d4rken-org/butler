    <string name="tour_manager_fab_title">فوری شارٹ کٹس</string>
    <string name="tour_manager_fab_body">اپنے اکثر استعمال ہونے والے ٹولز کے شارٹ کٹس کے لیے اور تمام ٹیب ایک ساتھ بند کرنے کے لیے یہاں ٹیپ کریں۔</string>
