    <!-- Debug Log -->
    <string name="debug_notification_channel_label">பிழைத்திருத்த அறிவிப்புகள்</string>
    <string name="debug_log_consent_title">பிழைத்திருத்தப் பதிவு</string>
    <string name="debug_log_consent_explanation">இந்த அம்சம் செயலி செய்யும் அனைத்தையும் பகிரக்கூடிய கோப்பில் பதிவுசெய்கிறது. உருவாக்கப்படும் கோப்பில் பாதுகாக்க வேண்டிய தகவல்கள் (எ.கா. கோப்புப் பெயர்கள், நிறுவப்பட்ட செயலிகள்) உள்ளன. நம்பகமான நபர்களுடன் மட்டுமே இதைப் பகிருங்கள் (எ.கா. ஒரு சிக்கலைச் சரிசெய்யும் உருவாக்குநர்).</string>
    <string name="debug_log_recording_progress">பிழைத்திருத்தப் பதிவைப் பதிவுசெய்கிறது</string>
    <string name="debug_log_record_action">பதிவுசெய்</string>
    <string name="debug_log_record_full_action">பிழைத்திருத்தப் பதிவை உருவாக்கு</string>
    <string name="debug_log_stop_action">பதிவுசெய்வதை நிறுத்து</string>
