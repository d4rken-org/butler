    <string name="workspace_empty_create_action">தாவலை உருவாக்கு</string>
    <string name="workspace_empty_create_hint">இணையாக வேலை செய்யலாம்: ஒரு தாவலை உருவாக்கி, அதை நீங்கள் விரும்பும் கருவியாக மாற்றுங்கள்.</string>
    <string name="workspace_empty_settings_action">அமைப்புகளைத் திற</string>
    <string name="workspace_empty_settings_hint">Butler ஐ உங்கள் விருப்பப்படி அமைக்கவும். கருவிகள் செயல்படும் விதத்தை மாற்றுங்கள்.</string>
    <string name="workspace_classic_empty_tabs_closed">திறந்த தாவல்கள் இல்லை. நீங்கள் தயாரானதும் தொடங்கலாம்.</string>
    <string name="workspace_classic_empty_tip">குறிப்பு: “தாவலை உருவாக்கு” என்பதைத் தட்டி, கோப்பு உலாவி, தேடல், திருத்தி போன்ற கருவிகளில் ஒன்றைத் தேர்ந்தெடுங்கள்.</string>

    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">ஒரு தாவலுடன் தொடங்குங்கள்</string>
    <string name="tour_first_tab_body">உலாவியைப் போல Butler தாவல்களில் செயல்படுகிறது: ஒவ்வொன்றும் தனிக் கருவி — கோப்பு உலாவி, தேடல், திருத்தி என இன்னும் பல. உங்கள் முதல் தாவலை உருவாக்குங்கள்.</string>
    <string name="tour_manager_fab_title">விரைவுக் குறுக்குவழிகள்</string>
    <string name="tour_manager_fab_body">நீங்கள் அதிகம் பயன்படுத்தும் கருவிகளுக்கான குறுக்குவழிகளையும் அனைத்துத் தாவல்களையும் ஒரே நேரத்தில் மூடும் வசதியையும் பெற இதைத் தட்டுங்கள்.</string>
    <string name="tour_manager_reorder_title">தாவல்களின் வரிசையை மாற்றுங்கள்</string>
    <string name="tour_manager_reorder_body">தாவலின் தலைப்புப் பட்டையை நீண்ட நேரம் அழுத்தி, விரும்பும் இடத்திற்கு இழுக்கவும். மற்ற எல்லா இடங்களிலும் தாவல்கள் இதே வரிசையில் தோன்றும்.</string>
    <string name="tour_manager_select_title">பல தாவல்களில் வேலை செய்யுங்கள்</string>
    <string name="tour_manager_select_body">தாவல்களைத் தேர்ந்தெடுக்கத் தொடங்க, ஒரு தாவலின் முன்னோட்டத்தை நீண்ட நேரம் அழுத்துங்கள். பிறகு மற்றவற்றைத் தட்டி, அனைத்தையும் ஒரே நேரத்தில் மூடலாம் அல்லது இடைநிறுத்தலாம்.</string>
    <string name="tour_manager_new_tab_title">புதிய தாவலைத் தொடங்குங்கள்</string>
    <string name="tour_manager_new_tab_body">புதிய தாவலுக்கான கருவியைத் தேர்ந்தெடுக்க இந்த அட்டையைத் தட்டுங்கள்.</string>
    <string name="tour_swipe_switch_title">தாவல்களுக்கிடையே ஸ்வைப் செய்யுங்கள்</string>
    <string name="tour_swipe_switch_body">திறந்துள்ள தாவல்களுக்கிடையே மாற, பக்கத்தில் எங்கு வேண்டுமானாலும் இடது அல்லது வலது பக்கம் ஸ்வைப் செய்யுங்கள்.</string>
    <string name="tour_swipe_create_title">தாவலைத் தொடங்க ஸ்வைப் செய்யுங்கள்</string>
    <string name="tour_swipe_create_body">கடைசித் தாவலைத் தாண்டி ஸ்வைப் செய்தால், Butler புதிய தாவலை வழங்கும்.</string>
    <string name="tour_swipe_panes_title">ஒரே நேரத்தில் ஒன்றுக்கு மேற்பட்ட தாவல்கள்</string>
    <string name="tour_swipe_panes_body">பெரிய திரையிலோ கிடைமட்டத் திரை நிலையிலோ, Butler பல தாவல்களை அருகருகே காட்டும். இது எப்போது நிகழும் என்பதைத் தாவல்கள் பிரிவிலுள்ள தளவமைப்பு அமைப்புகள் தீர்மானிக்கும்.</string>
    <string name="tour_panes_rail_title">உங்கள் அனைத்துத் தாவல்களும்</string>
    <string name="tour_panes_rail_body">திறந்துள்ள ஒவ்வொரு தாவலும் இங்கே இருக்கும். ஒன்றைத் தட்டி, அது செல்ல வேண்டிய பலகத்தைத் தேர்ந்தெடுங்கள். தாவல்களின் வரிசையை மாற்ற, ஒரு தாவலை நீண்ட நேரம் அழுத்தி இழுக்கவும்.</string>
    <string name="tour_panes_divider_title">பலகங்களின் அளவை மாற்றுங்கள்</string>
    <string name="tour_panes_divider_body">ஒரு பலகத்திற்கு அதிக இடம் கொடுக்க இந்தப் பிரிப்பானை இழுக்கவும்.</string>
    <string name="tour_panes_layout_title">அமைப்பை மாற்றுங்கள்</string>
    <string name="tour_panes_layout_body">பலகங்களை மாற்றி அமைக்க Butler பொத்தானைத் தட்டி, தளவமைப்பைத் தேர்ந்தெடுங்கள். தாவல் அமைப்புகளில் ஒவ்வொரு திரை நோக்குநிலைக்கும் ஒரு தளவமைப்பை நிலைநிறுத்தலாம்.</string>

