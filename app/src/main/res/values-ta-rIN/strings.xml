<resources>
    <string name="onboarding_welcome_title">Butler க்கு வரவேற்கிறோம்</string>
    <string name="onboarding_welcome_message">கோப்புகளுக்கான தாவல்கள்.\nஉலாவல், தேடல், திருத்தம் — அனைத்தும் ஒரே நேரத்தில்.</string>
    <string name="onboarding_welcome_subtitle">திறந்த மூல மென்பொருள். விளம்பரங்கள் இல்லை. கண்காணிப்பு இல்லை.\nஉங்களுக்கேற்ற கோப்பு உலாவி.</string>
    <string name="onboarding_welcome_action">உலாவத் தொடங்கு</string>
    <string name="onboarding_beta_title">எதிர்காலத்தை வடிவமைக்கலாம்</string>
    <string name="onboarding_beta_message">இது ஒரு பீட்டா (சோதனை) பதிப்பு. நகைச்சுவை உணர்வுடனும் மாற்றுத் திட்டத்துடனும் தொடருங்கள். நீங்கள் சந்திக்கும் சிக்கல்களைத் தெரிவியுங்கள்.</string>
    <string name="onboarding_beta_action">எனக்கு எதற்கும் பயமில்லை</string>
    <string name="onboarding_beta_feature_early_access_title">முன்கூட்டிய அணுகல்</string>
    <string name="onboarding_beta_feature_early_access_description">புதிய அம்சங்களை மற்றவர்களுக்கு முன்பே முயற்சித்துப் பாருங்கள்.</string>
    <string name="onboarding_beta_feature_influence_title">நேரடிப் பங்களிப்பு</string>
    <string name="onboarding_beta_feature_influence_description">உங்கள் கருத்துகள் Butler இன் வளர்ச்சியை வடிவமைக்கின்றன.</string>
    <string name="onboarding_beta_feature_feedback_title">சமூகத்தால் வழிநடத்தப்படுகிறது</string>
    <string name="onboarding_beta_feature_feedback_description">Butler ஐ மேம்படுத்தும் அனுபவமிக்க பயனர்களின் சமூகத்தில் இணையுங்கள்.</string>
    <string name="onboarding_privacy_title">தனியுரிமையும் தரவும்</string>
    <string name="onboarding_privacy_message">Butler இல் விளம்பரங்கள் இல்லை; பயனர் தரவை விற்பதும் இல்லை. உங்கள் தனியுரிமை எனக்கு முக்கியம்.</string>
    <string name="onboarding_privacy_read_action">தனியுரிமைக் கொள்கையைப் படி</string>
    <string name="onboarding_privacy_action">ஏற்கவும்</string>
    <string name="onboarding_skip_action">தவிர்</string>
    <string name="onboarding_progress_step">%2$d இல் %1$d</string>

    <string name="onboarding_workspaces_title">தாவல்களில் வேலை செய்யுங்கள்</string>
    <string name="onboarding_workspaces_message">உங்கள் இணைய உலாவியைப் போலவே, பல தாவல்களைத் திறந்து அவற்றுக்கிடையே மாறுங்கள்.</string>
    <string name="onboarding_workspaces_action">தொடரவும்</string>
    <string name="onboarding_workspaces_hint">ஒரே நேரத்தில் பல தாவல்களைத் திறந்து வைத்திருக்கலாம்.</string>
    <string name="onboarding_workspaces_explorer_title">கோப்பு உலாவி</string>
    <string name="onboarding_workspaces_explorer_description">உங்கள் கோப்புகளை உலாவுங்கள்.</string>
    <string name="onboarding_workspaces_searcher_title">தேடல்</string>
    <string name="onboarding_workspaces_searcher_description">தேவையானவற்றைக் கண்டுபிடியுங்கள்.</string>
    <string name="onboarding_workspaces_editor_title">திருத்தி</string>
    <string name="onboarding_workspaces_editor_description">கோப்புகளைத் திருத்துங்கள்.</string>
    <string name="onboarding_workspaces_apps_description">உங்கள் செயலிகளை நிர்வகியுங்கள்.</string>

