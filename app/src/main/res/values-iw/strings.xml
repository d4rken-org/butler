    <string name="tour_first_tab_title">מתחילים בלשונית</string>
    <string name="tour_first_tab_body">Butler עובד בלשוניות, כמו דפדפן: כל אחת היא כלי משלה — סייר, חיפוש, עורך ועוד. אפשר ליצור את הלשונית הראשונה שלך.</string>
