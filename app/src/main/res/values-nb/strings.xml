    <!-- Workspace > Guided tour -->
    <string name="tour_first_tab_title">Begynn med en fane</string>
    <string name="tour_first_tab_body">Butler arbeider i faner, som en nettleser: Hver fane er et eget verktøy — Filutforsker, Søk, Tekstredigering og mer. Opprett din første fane.</string>
    <string name="tour_manager_fab_title">Raske snarveier</string>
    <string name="tour_manager_fab_body">Trykk her for snarveier til verktøyene du bruker mest, og for å lukke alle faner på én gang.</string>
    <string name="tour_manager_reorder_title">Endre rekkefølgen på fanene</string>
    <string name="tour_manager_reorder_body">Trykk og hold på tittellinjen til en fane, og dra den dit du vil. Dette er rekkefølgen fanene vises i alle andre steder.</string>
    <string name="tour_manager_select_title">Arbeid med flere faner</string>
    <string name="tour_manager_select_body">Trykk og hold på forhåndsvisningen av en fane for å begynne å velge faner. Trykk deretter på resten og lukk eller sett alle på pause i én omgang.</string>
    <string name="tour_manager_new_tab_title">Start en ny fane</string>
    <string name="tour_manager_new_tab_body">Trykk på dette kortet for å velge et hvilket som helst verktøy til en ny fane.</string>
    <string name="tour_swipe_switch_title">Sveip mellom faner</string>
    <string name="tour_swipe_switch_body">Sveip til venstre eller høyre hvor som helst på siden for å bytte mellom de åpne fanene dine.</string>
    <string name="tour_swipe_create_title">Sveip for å starte en fane</string>
    <string name="tour_swipe_create_body">Sveip forbi den siste fanen, så tilbyr Butler deg en ny.</string>
    <string name="tour_swipe_panes_title">Mer enn én fane om gangen</string>
    <string name="tour_swipe_panes_body">På en større skjerm eller i liggende retning viser Butler flere faner side om side. Innstillingene for ruteoppsett under Faner bestemmer når det skjer.</string>
    <string name="tour_panes_rail_title">Alle fanene dine</string>
    <string name="tour_panes_rail_body">Alle åpne faner ligger her. Trykk på en og velg hvilken rute den skal vises i. Trykk og hold på en fane, og dra den for å endre rekkefølgen.</string>
    <string name="tour_panes_divider_title">Endre størrelsen på rutene</string>
    <string name="tour_panes_divider_body">Dra dette skillet for å gi én rute mer plass.</string>
