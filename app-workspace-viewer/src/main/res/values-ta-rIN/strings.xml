    <string name="viewer_apk_icon_overwrite_confirm">மாற்று</string>

    <!-- External change notice -->
    <string name="viewer_external_change_title">கோப்பு மாற்றப்பட்டுள்ளது</string>
    <string name="viewer_external_change_message">சாதனத்தில் இந்தக் கோப்பு மாற்றப்பட்டுள்ளது. அதை மீண்டும் ஏற்ற புதுப்பியுங்கள்.</string>
    <string name="viewer_external_change_gone_title">கோப்பு இனி இல்லை</string>
    <string name="viewer_external_change_gone_message">இந்தக் கோப்பு நீக்கப்பட்டது அல்லது அதை இனி அணுக முடியவில்லை.</string>

    <!-- Errors -->
    <string name="viewer_error_title">இந்தக் கோப்பைக் காட்ட முடியவில்லை</string>
    <string name="viewer_error_not_a_file_label">கோப்பு அல்ல</string>
    <string name="viewer_error_not_a_file_description">%1$s ஒரு சாதாரண கோப்பு அல்ல.</string>
    <string name="viewer_error_broken_symlink_label">முறிந்த குறுக்குவழி</string>
    <string name="viewer_error_broken_symlink_description">%1$s இனி இல்லாத ஒன்றைச் சுட்டுகிறது.</string>
    <string name="viewer_error_undecodable_label">சேதமடைந்த படம்</string>
    <string name="viewer_error_undecodable_description">%1$s ஐ டிகோடு செய்ய முடியவில்லை. கோப்பு முழுமையற்றதாகவோ சேதமடைந்ததாகவோ இருக்கலாம்.</string>
    <string name="viewer_error_file_gone_label">கோப்பு கிடைக்கவில்லை</string>
    <string name="viewer_error_file_gone_description">%1$s இனி இல்லை. அது நகர்த்தப்பட்டிருக்கலாம், மறுபெயரிடப்பட்டிருக்கலாம் அல்லது நீக்கப்பட்டிருக்கலாம்.</string>
    <string name="viewer_error_empty_file_label">காலியான கோப்பு</string>
    <string name="viewer_error_empty_file_description">%1$s காலியாக உள்ளது; காட்டுவதற்கு எதுவும் இல்லை.</string>
    <string name="viewer_error_apk_unreadable_label">வாசிக்க முடியாத APK</string>
    <string name="viewer_error_apk_unreadable_description">%1$s ஐ Android செயலித் தொகுப்பாகப் பகுத்தறிய முடியவில்லை.</string>
    <string name="viewer_error_icon_unavailable_label">சின்னம் இல்லை</string>
    <string name="viewer_error_icon_unavailable_description">%1$s இன் செயலிச் சின்னத்தை வாசிக்க முடியவில்லை.</string>
    <string name="viewer_error_icon_target_notfile_label">பெயர் ஏற்கனவே பயன்பாட்டில் உள்ளது</string>
    <string name="viewer_error_icon_target_notfile_description">%1$s ஏற்கனவே இங்கே உள்ளது; அது சாதாரண கோப்பு அல்ல என்பதால் அதை மாற்ற முடியாது.</string>
    <string name="viewer_error_icon_target_appeared_label">கோப்பு உருவாகியுள்ளது</string>
    <string name="viewer_error_icon_target_appeared_description">சேமிக்கும் இடத்தை நீங்கள் தேர்ந்தெடுத்துக்கொண்டிருந்தபோது %1$s உருவாக்கப்பட்டது. எதுவும் மேலெழுதப்படவில்லை; மீண்டும் முயலுங்கள்.</string>
    <string name="viewer_error_content_unreadable_label">இந்தக் கோப்பை வாசிக்க முடியவில்லை</string>
    <string name="viewer_error_content_unreadable_description">%1$s ஐப் பகிர்ந்த செயலி, அதை வாசிக்க Butler ஐ இனி அனுமதிக்கவில்லை. அந்தச் செயலியிலிருந்து அதை மீண்டும் பகிருங்கள்.</string>
    <string name="viewer_save_copy_action">ஒரு நகலைச் சேமி…</string>
    <string name="viewer_open_in_editor_action">திருத்தியில் திற</string>
    <string name="viewer_text_truncated_bytes">முன்னோட்டம் இந்தக் கோப்பின் முதல் %1$s அளவிற்கு மட்டுமே காட்டப்படுகிறது.</string>
    <string name="viewer_text_truncated_lines">முன்னோட்டம் இந்தக் கோப்பின் முதல் %1$s வரிகளுக்கு மட்டுமே காட்டப்படுகிறது.</string>
    <string name="viewer_text_truncated_width">இந்த முன்னோட்டத்தில் நீண்ட வரிகள் சுருக்கப்படுகின்றன.</string>
    <string name="viewer_text_unreadable_label">இந்தக் கோப்பை வாசிக்க முடியவில்லை</string>

