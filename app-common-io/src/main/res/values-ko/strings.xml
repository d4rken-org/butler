    <string name="path_action_folder_exists_title">폴더가 이미 존재합니다</string>
    <string name="path_action_file_exists_description">\"%1$s\"라는 파일이 \"%2$s\"에 이미 존재합니다.</string>
    <string name="path_action_folder_exists_description">\"%1$s\"라는 폴더가 \"%2$s\"에 이미 존재합니다.</string>

    <string name="path_action_not_found_title">파일을 찾을 수 없습니다</string>
    <string name="path_action_not_found_description">\"%1$s\" 파일이 삭제되었거나 이름이 변경되었거나 다른 위치로 이동했습니다.</string>

    <string name="path_action_permission_denied_title">권한 없음</string>
    <string name="path_action_permission_denied_description">권한 부족으로 \"%2$s\"의 \"%1$s\"에 접근할 수 없습니다.</string>
    <string name="path_action_permission_denied_no_mechanism_description">\"%2$s\"의 \"%1$s\"에 접근할 수 없습니다. 이 작업을 수행할 방법이 없습니다.</string>
    <string name="path_action_permission_denied_readonly_description">\"%2$s\"의 \"%1$s\"에 접근할 수 없습니다. 파일시스템이 읽기 전용입니다.</string>
    <string name="path_action_permission_denied_not_permitted_description">\"%2$s\"의 \"%1$s\"에 접근할 수 없습니다. 시스템이 작업을 거부했습니다.</string>

    <string name="path_action_insufficient_space_title">저장공간 부족</string>
