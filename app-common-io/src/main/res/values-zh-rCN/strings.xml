    <!-- Failed replacement: where the user's data ended up -->
    <string name="path_action_data_kept_title">替换未完成</string>
    <string name="path_action_data_kept_new_data_description">Butler 无法完成对 \"%1$s\" 的写入。新数据保留在 \"%2$s\" 的同一文件夹中。重命名该文件来恢复它，或删除它来丢弃它。</string>
    <string name="path_action_data_kept_original_in_place_description">Butler 无法完成对 \"%1$s\" 的写入，原文件保持不变。新数据保留在 \"%2$s\" 的同一文件夹中。重命名该文件来恢复它，或删除它来丢弃它。</string>
    <string name="path_action_data_kept_both_description">Butler 无法完成对 \"%1$s\" 的写入。没有数据丢失：原文件保留在 \"%2$s\" 同一文件夹中，新数据保留为 \"%3$s\"。重命名要保留的那个文件。</string>
    <string name="path_action_data_kept_maybe_partial_description">Butler 无法完成对 \"%1$s\" 的写入，且无法检查 \"%2$s\" 是否仍存在。可能在 \"%3$s\" 同一文件夹中保留了不完整的副本。删除任何文件前，请比较两者。</string>
    <string name="path_action_data_kept_intermediate_description">Butler 无法完成对 \"%1$s\" 的移动，且无法确定它是否已离开其原文件夹。数据要么保留在该文件夹中（名为 \"%2$s\"），要么已在 \"%3$s\"。删除任何文件前，请检查两处。</string>
    <string name="path_action_data_kept_uncertain_description">Butler 无法完成对 \"%1$s\" 的写入，且无法确定文件的最终位置。它是该文件夹中的三个文件之一：\"%1$s\" 本身、\"%2$s\" 或 \"%3$s\"。删除任何文件前，请检查这三个文件。</string>
    <string name="path_action_data_kept_uncertain_pair_description">Butler 无法完成对 \"%1$s\" 的写入，且无法确定文件的最终位置。它是该文件夹中的两个文件之一：\"%1$s\" 本身或 \"%2$s\"。删除任何文件前，请检查两者。</string>

