    <!-- Error Messages - Phase 1 -->
    <string name="provider_documents_error_requires_root">இந்த இருப்பிடத்தில் உலாவ Root அணுகல் தேவை. Butler செயலியின் அமைப்புகளில் Root அணுகலை இயக்குங்கள்.</string>
    <string name="provider_documents_error_requires_adb">இந்த இருப்பிடத்தில் உலாவ ADB அணுகல் தேவை. Butler இன் அனுமதி அமைவாக்கத்தில் அதை இயக்குங்கள்.</string>
    <string name="provider_documents_error_requires_storage">இந்த இருப்பிடத்தில் உலாவ சேமிப்பக அனுமதி தேவை. Butler செயலியின் அமைப்புகளில் சேமிப்பக அனுமதியை வழங்குங்கள்.</string>
    <string name="provider_documents_error_requires_permissions">இந்த இருப்பிடத்தில் உலாவ கூடுதல் அனுமதிகள் தேவை. Butler செயலியின் அமைப்புகளைச் சரிபாருங்கள்.</string>
    <string name="provider_documents_error_generic">இந்த இருப்பிடத்தை அணுக முடியவில்லை. அணுகல் விருப்பங்களுக்கு Butler செயலியைப் பாருங்கள்.</string>

