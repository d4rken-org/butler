# Customise this file, documentation can be found here:
# https://docs.fastlane.tools/actions/
# All available actions: https://docs.fastlane.tools/actions
# can also be listed using the `fastlane actions` command

# Change the syntax highlighting to Ruby
# All lines starting with a # are ignored when running `fastlane`

# If you want to automatically update fastlane if a new version is available:
# update_fastlane

# This is the minimum version number required.
# Update this, if you use features of a newer version
fastlane_version "2.226.0"

default_platform :android

platform :android do
  before_all do
  	#ensure_git_status_clean
  end

  # Closed testing. Play's API track names do not line up with the Console labels:
  # internal = Internal testing, alpha = Closed testing, beta = Open testing, production = Production.
  #
  # First upload only: an app stays in "draft" until its first release is published, and the Play
  # API rejects any non-draft release on a draft app. Run this lane once with
  # SUPPLY_RELEASE_STATUS=draft (or upload that first .aab through the Console), publish it there,
  # and every later run works unchanged with supply's default "completed" status.
  lane :beta do
    gradle(task: 'clean bundleGplayBeta')
    sh "bash ./remove_unsupported_languages.sh"
    supply(
        track: 'alpha',
        package_name: 'eu.darken.butler',
        skip_upload_changelogs: 'false',
        skip_upload_apk: 'true',
        skip_upload_images: 'true',
        skip_upload_screenshots: 'true',
        skip_upload_metadata: 'true',
    )
  end

  lane :production do
    gradle(task: 'clean bundleGplayRelease')
    sh "bash ./remove_unsupported_languages.sh"
    supply(
        track: 'production',
        rollout: '0.10',
        package_name: 'eu.darken.butler',
        skip_upload_changelogs: 'false',
        skip_upload_apk: 'true',
        skip_upload_images: 'true',
        skip_upload_screenshots: 'true',
        skip_upload_metadata: 'true',
    )
  end

  lane :listing_only do
    sh "bash ./remove_unsupported_languages.sh"
    supply(
      track: 'production',
      skip_upload_apk: 'true',
      skip_upload_images: 'true',
      skip_upload_screenshots: 'true',
      skip_upload_changelogs: true,
      skip_upload_aab: 'true'
    )
  end

  # Uploads only the screenshots in fastlane/metadata/android/*/images/*Screenshots.
  # Icon and feature graphic are left untouched (skip_upload_images), as are the app
  # binaries, the listing texts and the changelogs.
  lane :screenshots_only do
    sh "bash ./remove_unsupported_languages.sh"
    supply(
      track: 'production',
      package_name: 'eu.darken.butler',
      skip_upload_apk: 'true',
      skip_upload_aab: 'true',
      skip_upload_metadata: 'true',
      skip_upload_changelogs: 'true',
      skip_upload_images: 'true',
      skip_upload_screenshots: 'false',
    )
  end

  after_all do |lane|
    # This block is called, only if the executed lane was successful

    # slack(
    #   message: "Successfully deployed new App Update."
    # )
  end

  error do |lane, exception|
    # slack(
    #   message: exception.message,
    #   success: false
    # )
  end
end