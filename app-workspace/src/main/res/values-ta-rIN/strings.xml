    <!-- Session Restoration Error -->
    <string name="workspace_session_restoration_error_title">அமர்வை மீட்டெடுக்க முடியவில்லை</string>
    <string name="workspace_session_restoration_error_description">உங்கள் முந்தைய தாவல் அமர்வை மீட்டெடுக்க முடியவில்லை. எதிர்காலப் புதுப்பிப்பில் சரிசெய்யப்படும் ஒரு மென்பொருள் பிழை இதற்குக் காரணமாக இருக்கலாம்.\n\nButler ஐத் தொடர்ந்து பயன்படுத்த சேமித்த அமர்வை அழிக்கலாம் அல்லது புதுப்பிப்புக்காகக் காத்திருக்கலாம்.</string>
    <string name="workspace_session_restoration_error_clear_action">அமர்வை அழி</string>
    <string name="workspace_session_restoration_error_report_action">சிக்கலைப் புகாரளி</string>
    <string name="workspace_session_restoration_error_confirm_title">அமர்வை அழிக்கவா?</string>
    <string name="workspace_session_restoration_error_confirm_description">இது உங்கள் சேமித்த தாவல் அமர்வை நிரந்தரமாக நீக்கும். இந்தச் செயலைச் செயல்தவிர்க்க முடியாது.</string>

