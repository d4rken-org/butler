    <string name="workspace_settings_layout_mode_auto">தானியங்கி</string>
    <string name="workspace_settings_layout_mode_auto_desc">சிறிய திரைகளில் வழக்கமான முறை, பெரிய திரைகளில் தாவல் பட்டையுடன் பலகங்கள்.</string>
    <string name="workspace_settings_layout_mode_classic">வழக்கமானது</string>
    <string name="workspace_settings_layout_mode_classic_desc">தாவல் பட்டையின்றி, ஒரு நேரத்தில் ஒரு பலகம்.</string>
    <string name="workspace_settings_layout_mode_adaptive">தழுவல்</string>
    <string name="workspace_settings_layout_mode_adaptive_desc">தாவல் பட்டையுடன் திரையில் அடங்கும் அளவு பலகங்கள். Butler மெனுவிலிருந்து ஒரு தளவமைப்பை நிலைநிறுத்துங்கள்.</string>
    <string name="workspace_layout_dialog_mode_adaptive_desc">தாவல் பட்டையுடன் திரையில் அடங்கும் அளவு பலகங்கள்.</string>
    <string name="workspace_settings_layout_mode_adaptive_pinned_format">தழுவல் (%1$s)</string>
    <string name="workspace_settings_layout_mode_single_rail">தாவல் பட்டையுடன் ஒற்றைப் பலகம்</string>
    <string name="workspace_settings_layout_mode_single_rail_desc">ஒரு தாவல் பலகமும் பல பலகத் தளவமைப்புகளில் உள்ள தாவல் பட்டையும். இந்தப் பட்டை திரையின் ஒரு பகுதியை எடுத்துக்கொள்ளும்.</string>
    <string name="workspace_settings_layout_mode_dual_vertical">இரு செங்குத்துப் பலகங்கள்</string>
    <string name="workspace_settings_layout_mode_dual_vertical_desc">அருகருகே இரண்டு பலகங்கள் (இடது/வலது).</string>
    <string name="workspace_settings_layout_mode_dual_horizontal">இரு கிடைமட்டப் பலகங்கள்</string>
    <string name="workspace_settings_layout_mode_dual_horizontal_desc">ஒன்றன்மேல் ஒன்றாக இரண்டு பலகங்கள் (மேல்/கீழ்).</string>
    <string name="workspace_settings_layout_mode_triple_sidebar_left">மூன்று பலகங்கள், பெரியது இடப்புறம்</string>
    <string name="workspace_settings_layout_mode_triple_sidebar_left_desc">இடப்புறம் ஒரு பெரிய பலகம், வலப்புறம் ஒன்றன்மேல் ஒன்றாக இரண்டு சிறிய பலகங்கள்.</string>
    <string name="workspace_settings_layout_mode_triple_sidebar_right">மூன்று பலகங்கள், பெரியது வலப்புறம்</string>
    <string name="workspace_settings_layout_mode_triple_sidebar_right_desc">இடப்புறம் ஒன்றன்மேல் ஒன்றாக இரண்டு சிறிய பலகங்கள், வலப்புறம் ஒரு பெரிய பலகம்.</string>
    <string name="workspace_settings_layout_mode_quad_grid">நான்கு பலகக் கட்டம்</string>
    <string name="workspace_settings_layout_mode_quad_grid_desc">2×2 கட்டத்தில் நான்கு பலகங்கள்.</string>

    <string name="workspace_settings_pane_click_to_focus_title">கவனம் செலுத்தக் கிளிக் செய்</string>
    <string name="workspace_settings_pane_click_to_focus_desc">கவனத்தில் இல்லாத பலகத்தின் முதல் கிளிக் அதன் மீது கவனம் செலுத்த மட்டுமே பயன்படும். கவனத்தில் இல்லாத பலகங்கள் மவுஸ் சுட்டிக்குறிக்கு எதிர்வினை செய்யாது. அவற்றுடன் நேரடியாகச் செயல்பட இதை முடக்குங்கள்.</string>

    <string name="workspace_settings_rail_button_title">Butler பொத்தான்</string>
    <string name="workspace_settings_rail_button_desc">தாவல் பட்டையில் Butler பொத்தான் எங்கே இருக்க வேண்டும் என்பதைத் தேர்ந்தெடு.</string>
    <string name="workspace_settings_rail_button_leading">தொடக்கம்</string>
    <string name="workspace_settings_rail_button_leading_desc">நெடுவாக்கில் தாவல்களுக்கு முன்பும், கிடைமட்டத்தில் அவற்றுக்கு மேலேயும்.</string>
    <string name="workspace_settings_rail_button_trailing">முடிவு</string>
    <string name="workspace_settings_rail_button_trailing_desc">நெடுவாக்கில் தாவல்களுக்குப் பிறகும், கிடைமட்டத்தில் அவற்றுக்குக் கீழேயும். ஒரு கையால் பயன்படுத்தும்போது கட்டைவிரலுக்கு எட்டும் இடத்தில்.</string>

    <!-- Session -->
    <string name="workspace_settings_session_title">அமர்வு</string>
    <string name="workspace_settings_session_restore_title">தொடங்கும்போது தாவல்களை மீட்டெடு</string>
    <string name="workspace_settings_session_restore_desc">செயலி தொடங்கும்போது முன்பு திறந்திருந்த தாவல்களைத் தானாக மீட்டெடு.</string>
    <string name="workspace_settings_autopause_title">செயலற்ற தாவல்களை இடைநிறுத்து</string>
    <string name="workspace_settings_autopause_desc">சிறிது நேரமாக நீங்கள் பார்க்காத தாவல்கள் நினைவகத்தையும் பேட்டரியையும் சேமிக்க இடைநிறுத்தப்படும். அவற்றைத் திறந்தால் மீண்டும் இயங்கும்.</string>
    <string name="workspace_settings_autopause_delay_title">இடைநிறுத்துவதற்கு முன் காத்திருக்கும் நேரம்</string>
    <string name="workspace_settings_autopause_delay_desc">ஒரு தாவல் கண்ணில் படாமல் எவ்வளவு நேரம் இருந்தால் இடைநிறுத்த வேண்டும்.</string>
    <string name="workspace_settings_undoclose_title">தாவல்களை மூடுவதைச் செயல்தவிர்</string>
    <string name="workspace_settings_undoclose_desc">தாவலை மூடிய பிறகு, அதை மீண்டும் திறக்கும் வாய்ப்பு சில வினாடிகளுக்குக் காட்டப்படும்.</string>
    <string name="workspace_settings_session_data_title">அமர்வுத் தரவு</string>
