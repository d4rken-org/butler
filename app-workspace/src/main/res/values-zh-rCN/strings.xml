    <string name="workspace_settings_layout_mode_dual_vertical_desc">两个窗格左右并排显示。</string>
    <string name="workspace_settings_layout_mode_dual_horizontal">水平双栏</string>
    <string name="workspace_settings_layout_mode_dual_horizontal_desc">两个窗格上下叠放显示。</string>
    <string name="workspace_settings_layout_mode_triple_sidebar_left">三栏（侧栏在左）</string>
    <string name="workspace_settings_layout_mode_triple_sidebar_left_desc">左侧一个大窗格，右侧两个较小窗格上下叠放。</string>
    <string name="workspace_settings_layout_mode_triple_sidebar_right">三栏（侧栏在右）</string>
    <string name="workspace_settings_layout_mode_triple_sidebar_right_desc">左侧两个较小窗格上下叠放，右侧一个大窗格。</string>
    <string name="workspace_settings_layout_mode_quad_grid">四宫格</string>
    <string name="workspace_settings_layout_mode_quad_grid_desc">四个窗格以 2×2 网格排列。</string>

    <string name="workspace_settings_pane_click_to_focus_title">点击以聚焦</string>
    <string name="workspace_settings_pane_click_to_focus_desc">点击未聚焦的窗格时，第一次点击只会使其获得焦点，未聚焦的窗格不会响应鼠标指针。关闭此选项可直接与其交互。</string>

    <string name="workspace_settings_rail_button_title">Butler 按钮</string>
