# Play Store screenshots: only the English set is committed, the localized runs are generated
fastlane/metadata/android/*/images/phoneScreenshots/*.png
fastlane/metadata/android/*/images/sevenInchScreenshots/*.png
fastlane/metadata/android/*/images/tenInchScreenshots/*.png
!fastlane/metadata/android/en-US/images/phoneScreenshots/*.png
!fastlane/metadata/android/en-US/images/sevenInchScreenshots/*.png
!fastlane/metadata/android/en-US/images/tenInchScreenshots/*.png
# Staging area of copy_screenshots.sh, removed on every exit path but never a repo file
